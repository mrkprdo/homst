# ── Shared ──
DATABASE_URL=postgresql+asyncpg://postgres:dev@postgres:5432/homst
DATABASE_URL_ALEMBIC=postgresql://postgres:dev@localhost:5432/homst
REDIS_URL=redis://redis:6379

# ── Dev Only ──
DEBUG=true
CORS_ALLOW_ALL=true

# ── Empty in dev ──
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173

# ── Spotify "Now Playing" (optional) ──
# Client ID of a Spotify app; add http://localhost:5173 (and the dev nginx
# origin, e.g. https://localhost:8999) as Redirect URIs in that app.
SPOTIFY_CLIENT_ID=
