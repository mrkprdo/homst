# HOMST production configuration — copy to `.env` next to the compose file.
# Docker Compose reads `.env` automatically: it resolves the image tag
# (HOMST_VERSION) from it and passes everything else to the HOMST container.
#
# None of it is required: without the file, `docker compose -f
# docker-compose.prod.yml up -d` bootstraps everything (database password
# into the homst_secrets volume, TLS certificates into homst_ssl) and reuses
# it on later starts.
#
# Prefer a single file. If an older install still has `.env.prod`, it is
# loaded first for backwards compatibility and `.env` overrides it.

# ── Image tag ──
# latest = stable release · dev = nightly · dev-<sha> = specific nightly ·
# x.y.z = pinned release. Compose resolves this before anything starts; the
# value cannot live in .env.prod.
HOMST_VERSION=latest

# ── Database ──
# The bundled Postgres uses database `homst` and user `postgres`. Leave the
# password empty to have one generated on first boot; set it to choose your
# own — or to keep an existing `pg_data` volume working (it expects whatever
# password that volume was initialised with).
POSTGRES_PASSWORD=
# Fixed for the bundled database (informational):
# POSTGRES_USER=postgres
# POSTGRES_DB=homst

# Re-use an existing Postgres instead of the bundled one (it then just sits
# unused):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/homst

# ── Redis ──
# Runs inside the app container; point this at another server to opt out.
REDIS_URL=redis://127.0.0.1:6379

# ── mDNS discovery ──
# Advertise the dashboard on the LAN as homst.local (or a custom instance
# name). Set MDNS_ENABLED=false to opt out.
MDNS_ENABLED=true
MDNS_INSTANCE_NAME=HOMST

# ── TLS ──
# Address(es) the dashboard is reached at, comma-separated
# (e.g. 192.168.1.50,homst.local). Adds subjectAltNames to the generated
# server certificate so PWA install and Web Push see a trusted padlock.
# Add an address later with:
#   docker compose -f docker-compose.prod.yml exec homst homst-cert <host>
HOMST_TLS_HOSTS=

# ── CORS (only relevant when calling the API from another origin) ──
CORS_ALLOW_ALL=false
ALLOWED_ORIGINS=http://localhost:5173

# ── Debug: log every SQL statement (keep false in production) ──
DEBUG=false

# ── Spotify "Now Playing" widget (optional) ──
# Client ID of your Spotify app (https://developer.spotify.com/dashboard).
# Add the dashboard's address as a Redirect URI in that app:
#   https://<host>:8443
# Leave empty to paste the Client ID per browser in the widget instead.
SPOTIFY_CLIENT_ID=

# ── Google Calendar sync (optional) ──
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Push notifications (optional) ──
# HOMST sends Web Push directly to phones/browsers — no FCM/APNs account
# needed, and no SMTP/mail account for reminders either. Web Push is the
# notification channel. A VAPID key pair is generated automatically on first
# use and stored in the database; set both values below only if you want to
# pin your own keys. VAPID_SUBJECT is the contact address advertised to push
# services (mailto: or https: URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:homst@localhost

# ── In-app updates (optional) ──
# Enable by starting the updater profile:
#   docker compose -f docker-compose.prod.yml --profile updates up -d
# Update-check frequency and display prompts are configured in the UI.
# Set this to true to disable all in-app update actions and background checks.
# The updater pulls anonymously, so the GitHub repository and its GHCR
# container package must be public. No registry token or GitHub key is needed.
HOMST_SELF_UPDATE_DISABLED=false

# Uncomment to keep the updater profile enabled for every compose command:
# COMPOSE_PROFILES=updates

# Rootless Docker or Podman users only: Docker socket the updater mounts.
# Defaults to /var/run/docker.sock.
# HOMST_DOCKER_SOCKET=/run/user/1000/docker.sock
