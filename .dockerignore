# Keep the build context to what the Dockerfile actually COPYs.
.git
.github
docs
Makefile
README.md
LICENSE
docker-compose*.yml

# Secrets — never into the image
.env
.env.*

# Dev/state
.venv
pg_data

# API
api/uploads
api/tests
api/__pycache__
api/**/__pycache__
api/.pytest_cache
api/.ruff_cache
api/.coverage

# Web
web/node_modules
web/dist
web/e2e
web/playwright-report
web/test-results
web/.env*
# Generated by packages/design-tokens during the image build
web/public/tokens.css
web/public/shadows.css

# Certificates are generated at runtime, never baked in
nginx/ssl
