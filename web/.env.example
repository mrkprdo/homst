# Spotify integration for the homepage Now Playing widget.
# For Docker deployments prefer the runtime setting: SPOTIFY_CLIENT_ID in the
# root .env (served to every client). This build-time variable is for
# local development or self-built images.
# Get your Client ID from https://developer.spotify.com/dashboard
# Add your app's redirect URI: http://localhost:5173 (dev) or your production URL
VITE_SPOTIFY_CLIENT_ID=
